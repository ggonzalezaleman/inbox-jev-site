{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/classify.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,src/**,shots/**,*.png,*.svg,README.md}"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.inboxjev.dev"
        }
      ],
      "destination": "https://inboxjev.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "inbox-jev-site.vercel.app"
        }
      ],
      "destination": "https://inboxjev.dev/$1",
      "permanent": true
    }
  ]
}
