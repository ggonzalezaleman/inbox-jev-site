{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/classify.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,src/**,shots/**,*.png,*.svg,README.md}"
    }
  }
}
